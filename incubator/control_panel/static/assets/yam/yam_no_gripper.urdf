<?xml version="1.0"?>
<!--
  Browser-facing YAM arm model derived from i2rt's yam/yam.urdf.
  The fixed source alignment joint is kept out of the six commanded joints,
  and gripper-only links are omitted because YamHeadRobot uses no_gripper.
-->
<robot name="yam_no_gripper">
  <link name="root" />

  <link name="base">
    <visual>
      <origin xyz="-0.187501 -0.0464005 -0.0374966" rpy="0 0 0" />
      <geometry><mesh filename="meshes/base.stl" /></geometry>
      <material name="yam_base"><color rgba="0.317647 0.121569 0.498039 1" /></material>
    </visual>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="-0.119501 -0.0464 -0.0374968" rpy="0 0 0" />
      <geometry><mesh filename="meshes/link1.stl" /></geometry>
      <material name="yam_link1"><color rgba="0.72549 0.45098 0.317647 1" /></material>
    </visual>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="-0.0740001 -0.08025 -0.0174977" rpy="0 0 0" />
      <geometry><mesh filename="meshes/link2.stl" /></geometry>
      <material name="yam_link2"><color rgba="0 0.4 0.6 1" /></material>
    </visual>
  </link>

  <link name="link3">
    <visual>
      <origin xyz="-0.0740003 -0.0813 -0.281499" rpy="0 0 0" />
      <geometry><mesh filename="meshes/link3.stl" /></geometry>
      <material name="yam_link3"><color rgba="0.552941 0.580392 0.203922 1" /></material>
    </visual>
  </link>

  <link name="link4">
    <visual>
      <origin xyz="-0.0140003 -0.0125 -0.0364989" rpy="0 0 0" />
      <geometry><mesh filename="meshes/link4.stl" /></geometry>
      <material name="yam_link4"><color rgba="0.545098 0.52549 0.419608 1" /></material>
    </visual>
  </link>

  <link name="link5">
    <visual>
      <origin xyz="0.0265 -0.0463995 0.0375" rpy="0 0 0" />
      <geometry><mesh filename="meshes/link5.stl" /></geometry>
      <material name="yam_link5"><color rgba="0.827451 0.623529 0.784314 1" /></material>
    </visual>
  </link>

  <link name="end_effector" />

  <joint name="yam_model_alignment" type="fixed">
    <origin xyz="0 0 0" rpy="0 1.5708 1.5708" />
    <parent link="root" />
    <child link="base" />
  </joint>

  <joint name="joint1" type="revolute">
    <origin xyz="-0.068 -6.80012e-16 -5.41234e-16" rpy="8.32667e-17 2.01874e-17 -3.6657e-17" />
    <axis xyz="-1 0 0" />
    <parent link="base" />
    <child link="link1" />
    <limit effort="1" velocity="1" lower="-2.61799" upper="3.05433" />
  </joint>

  <joint name="joint2" type="revolute">
    <origin xyz="-0.0455 -0.0339 -0.02" rpy="4.86604e-16 3.99049e-14 -3.14159" />
    <axis xyz="3.58252e-15 1 -3.2007e-16" />
    <parent link="link1" />
    <child link="link2" />
    <limit effort="1" velocity="1" lower="-3.9968e-14" upper="3.14159" />
  </joint>

  <joint name="joint3" type="revolute">
    <origin xyz="4.08431e-07 -0.0688 0.264" rpy="-1.01074e-14 7.11653e-14 -3.14159" />
    <axis xyz="4.54273e-15 1 1.04275e-14" />
    <parent link="link2" />
    <child link="link3" />
    <limit effort="1" velocity="1" lower="0" upper="3.14159" />
  </joint>

  <joint name="joint4" type="revolute">
    <origin xyz="-0.0600003 -0.0688 -0.244999" rpy="1.03997e-14 -8.62366e-14 -4.39823e-15" />
    <axis xyz="0 1 0" />
    <parent link="link3" />
    <child link="link4" />
    <limit effort="1" velocity="1" lower="-1.5708" upper="1.5708" />
  </joint>

  <joint name="joint5" type="revolute">
    <origin xyz="-0.0405003 0.0338995 -0.0739989" rpy="-2.58127e-15 -1.37665e-15 -1.04686e-15" />
    <axis xyz="-1 0 0" />
    <parent link="link4" />
    <child link="link5" />
    <limit effort="1" velocity="1" lower="-1.5708" upper="1.5708" />
  </joint>

  <joint name="joint6" type="revolute">
    <origin xyz="0.0404996 2.39858e-07 -0.0356" rpy="1.00451e-15 -4.22055e-16 -1.11022e-16" />
    <axis xyz="-1.46014e-15 -2.40808e-14 1" />
    <parent link="link5" />
    <child link="end_effector" />
    <limit effort="1" velocity="1" lower="-2.0944" upper="2.0944" />
  </joint>
</robot>
